# ─────────────────────────────────────────────────────────────────────────────
# StaffMint backend configuration. Every value has a working dev default (mock
# providers), so `npm run dev` works with NO .env at all. Copy to .env and fill
# real values before production. Full checklist: docs/ENV_AND_CREDENTIALS.md
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000          # used in signed file links
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

MONGODB_URI=mongodb://localhost:27017/staffmint
REDIS_URL=redis://localhost:6379
JOBS_DRIVER=inline                              # inline | bullmq (run `npm run worker`) | off

# Secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=60
FIELD_ENCRYPTION_KEY=ZGV2LWZpZWxkLWVuY3J5cHRpb24ta2V5LTMyYnl0ZXM=   # openssl rand -base64 32
FILE_URL_SECRET=dev-file-url-secret
ADMIN_API_KEY=dev-admin-key

# ── Provider selection (mock = no external calls) ──
OTP_PROVIDER=mock               # mock | msg91 | twilio
MESSAGING_PROVIDER=mock         # mock | meta | aisensy
PUSH_PROVIDER=mock              # mock | fcm
LLM_PROVIDER=rules              # rules | gemini
SPEECH_PROVIDER=mock            # mock | gemini
STORAGE_PROVIDER=local          # local | s3 (Cloudflare R2)
PDF_PROVIDER=simple             # simple | puppeteer (needed for Hindi PDFs)
PAYMENT_PROVIDER=mock           # mock | razorpay
EMAIL_PROVIDER=mock             # mock | resend
GEO_PROVIDER=mock               # mock | google
FACE_PROVIDER=mock              # mock | rekognition (mock refuses to decide in production)
ANALYTICS_PROVIDER=mock         # mock | posthog

# OTP
OTP_MOCK_CODE=123456
OTP_TTL_SEC=300
MSG91_AUTH_KEY=fake-msg91-auth-key
MSG91_TEMPLATE_ID=fake-msg91-template-id
TWILIO_ACCOUNT_SID=ACfakefakefakefakefakefakefakefake
TWILIO_AUTH_TOKEN=fake-twilio-auth-token
TWILIO_FROM=+15005550006

# WhatsApp (Meta Cloud API or AiSensy BSP)
WHATSAPP_META_TOKEN=fake-meta-whatsapp-token
WHATSAPP_META_PHONE_NUMBER_ID=000000000000000
WHATSAPP_META_APP_SECRET=fake-meta-app-secret
WHATSAPP_VERIFY_TOKEN=fake-verify-token
WHATSAPP_GRAPH_VERSION=v21.0
AISENSY_API_KEY=fake-aisensy-api-key
AISENSY_WEBHOOK_SECRET=fake-aisensy-webhook-secret

# Push — Firebase service-account JSON, base64 encoded (base64 -w0 sa.json)
FCM_SERVICE_ACCOUNT_BASE64=

# Google Gemini (Mint assistant + voice)
GEMINI_API_KEY=fake-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
ASSISTANT_RULES_FASTPATH=true    # use the free rule parser first when it is confident

# Storage — Cloudflare R2 (S3-compatible, private bucket)
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=https://fake-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=staffmint-private
S3_ACCESS_KEY_ID=fake-r2-access-key-id
S3_SECRET_ACCESS_KEY=fake-r2-secret-access-key
SIGNED_URL_TTL_SEC=600

# PDF
CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# Razorpay
RAZORPAY_KEY_ID=rzp_test_fakekeyid0000
RAZORPAY_KEY_SECRET=fake-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=fake-razorpay-webhook-secret

# Email (Resend)
RESEND_API_KEY=re_fake_resend_api_key
EMAIL_FROM=StaffMint <no-reply@staffmint.app>

# Google Maps (reverse geocoding of the shop pin)
GOOGLE_MAPS_API_KEY=fake-google-maps-api-key

# Face match (AWS Rekognition, Mumbai region by default)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=fake-aws-access-key-id
AWS_SECRET_ACCESS_KEY=fake-aws-secret-access-key
FACE_MATCH_THRESHOLD=90
FACE_UNSURE_THRESHOLD=75

# Observability
SENTRY_DSN=
POSTHOG_API_KEY=phc_fake_posthog_key
POSTHOG_HOST=https://us.i.posthog.com

# Product
SUPPORT_WHATSAPP=+910000000000
MIN_APP_VERSION=0.1.0
DEFAULT_COUNTRY=IN
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
